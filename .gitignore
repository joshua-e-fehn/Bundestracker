.worktrees/
.vibe/sources/

# pixi
# `pixi.lock` is *not* ignored — it pins the solved environment, so committing
# it is what makes `pixi run` reproducible across machines and the cron host.
.pixi/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/

# env
.env
.env.*
!.env.example

# pipeline sync state — the `aktualisiert` watermark, the quarantine and the
# document hashes. Per-host operational state about *fetching*, not data about
# parliament, so it belongs to the machine rather than to the repo. Losing it
# costs a wider fetch window, not correctness: every write is an upsert.
.bundestrack-state.json

# os
.DS_Store
