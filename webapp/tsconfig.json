{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `scripts/render-icons.ts` is an operator script, not app code: it imports
  // `@resvg/resvg-js`, which is deliberately not a dependency (see the file's
  // header) and is installed on demand with `bun add --no-save`. Without this
  // exclusion `tsc` — and so `next build`, which runs it — fails on the
  // unresolvable import for a file the app never loads.
  "exclude": ["node_modules", "scripts/render-icons.ts"]
}
