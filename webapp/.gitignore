# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which documents what the real ones must contain.
!.env.example

# vercel
.vercel

# convex
# Generated by `bunx convex dev` / `bunx convex codegen` from the schema and
# function signatures — regenerated on every run, so it is derived, not source.
convex/_generated/
convex/betterAuth/_generated/
.convex/

# typescript
*.tsbuildinfo
next-env.d.ts
